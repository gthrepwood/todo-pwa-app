{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/backend/server.js",
            "env": {
                "LOG": "1",
                "NODE_PATH": "/var/tmp/node_modules"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch with Debug Log",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/backend/server.js",
            "env": {
                "LOG": "1",
                "CACHE": "0"
            }
        }
    ]
}